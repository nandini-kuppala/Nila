<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      LiteRT-LM declares minSdk 31, and it is used by exactly one optional
      feature: the vision model that describes a frame from the cot. Raising
      the whole app to 31 to accommodate it would drop every phone on Android
      8 to 11 from a baby monitor, which is the wrong trade: those phones run
      the audio monitor perfectly well.

      So the library is admitted at minSdk 26 and SceneDescriber refuses to
      load below 31, which is checked before any LiteRT-LM class is touched.
    -->
    <uses-sdk tools:overrideLibrary="com.google.ai.edge.litertlm" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.NFC" />
    <!-- For the opt-in laptop dashboard only. The app makes no outbound
         requests; this permits a listening socket on the local network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      The phone-to-phone alert link.

      ACCESS_WIFI_STATE and CHANGE_WIFI_MULTICAST_STATE are for the receiving
      phone: it holds a Wi-Fi lock so Doze does not park the radio between
      heartbeats, and a multicast lock so mDNS discovery still works with the
      screen off. Several OEM builds, vivo's included, drop inbound multicast to
      a sleeping app without one.

      FOREGROUND_SERVICE_CONNECTED_DEVICE, and not FOREGROUND_SERVICE_DATA_SYNC:
      since Android 15 a dataSync foreground service is capped at six hours per
      day, which is shorter than a night. See ParentService.
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!--
      Level 4 only, and it is not granted at install on Android 14 and later:
      the platform reserves that for calling and alarm-clock apps. Everything
      else has to send the user to a Settings page to ask. Declared so the app
      *can* ask; nothing depends on the answer, because AlertPlayer sounds on the
      alarm stream either way.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:name=".NilaApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nila">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Nila">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".monitor.MonitorService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />

        <!--
          The camera lane, as its own service.

          Separate from MonitorService rather than folded into it, because the
          two run at the same time: the audio lane holds the microphone all
          night and this one holds the camera. One service declaring both types
          would work, but stopping the watch would then have to either stop the
          microphone too or leave a camera-typed service running with no camera.

          FOREGROUND_SERVICE_TYPE_CAMERA is what lets the watch survive the
          screen going off, which is the entire reason it exists.
        -->
        <service
            android:name=".monitor.WatchService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!--
          The receiving phone's half of the link.

          connectedDevice rather than dataSync: dataSync is capped at six hours
          in twenty-four from Android 15, and a monitor that stops receiving at
          4am without saying so is the exact failure this feature exists to
          prevent.
        -->
        <service
            android:name=".phonelink.ParentService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!--
          The full-screen level-4 alert.

          excludeFromRecents and noHistory because this is an interruption, not
          a place: it should not be something you can swipe back to in the task
          switcher half an hour later and mistake for a live alarm.
        -->
        <activity
            android:name=".phonelink.AlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Nila" />

        <!-- Feeding and nappy reminders. Not exported: the only thing that
             should ever fire these is this app's own alarm. -->
        <receiver
            android:name=".actions.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.nila.REMIND" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
