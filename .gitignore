# ---------------------------------------------------------------- secrets
# Nila makes no API calls and ships no keys. These patterns are here so that
# stays true: anything anyone adds later lands in a file git will not take.
.env
.env.*
!.env.example
*.pem
*.p12
*.jks
*.keystore
client_secret*.json
service-account*.json
secrets.properties
local.properties

# ------------------------------------------------------------ build output
build/
.gradle/
.kotlin/
*.apk
*.aab
*.iml
.idea/
captures/
.externalNativeBuild/
.cxx/

# ------------------------------------------------------------------ python
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# -------------------------------------------------------------- ML working
# Datasets are downloaded by ml/src/download.py -- 2.8 GB of ESC-50,
# UrbanSound8K and Donate-a-Cry that belong to their publishers, not here.
ml/data/

# Training artefacts are regenerated by the pipeline. The copies the app
# actually ships live in android/app/src/main/assets and are tracked.
ml/models/
ml/cache/

# Large models are downloaded on demand at runtime, never committed.
*.task
*.litertlm
*.pkl
*.keras

# --------------------------------------------------------------------- misc
.DS_Store
Thumbs.db
*.log.gz
